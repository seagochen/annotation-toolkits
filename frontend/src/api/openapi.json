            "title": "Task Type"
          },
          "root": {
            "type": "string",
            "title": "Root"
          },
          "status": {
            "type": "string",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "task_type",
